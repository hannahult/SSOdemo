@using Microsoft.AspNetCore.Components.Authorization

<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-3 px-3">
    <a class="navbar-brand" href="">Client 2 (Blazor WASM)</a>

    <div class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto">
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item">
                        <a href="authentication/profile" class="nav-link">Hello @context.User.Identity?.Name!</a>
                    </li>
                    <li class="nav-item">
                        <a href="authentication/logout" class="nav-link">Logout</a>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item">
                        <a href="authentication/login" class="nav-link">Login</a>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </div>
</nav>
