@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
<PageTitle>Home</PageTitle>

<div class="text-center mt-5">
    <h1 class="display-4">Welcome to Client 2 Blazor WebAssembly Standalone App</h1>

    @if (context?.User?.Identity?.IsAuthenticated == true)
    {
        <h4>Hello @context.User.Identity.Name!</h4>
        <p>You are logged in via SSO.</p>
        <a class="btn btn-primary" href="secure">Show protected information</a>
        <RemoteAuthenticatorView Action="LogOut" />
    }
    else
    {
        <h4>You are not logged in.</h4>
        <p>
            <a class="btn btn-primary" href="authentication/login">Login and show protected information</a>
        </p>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private AuthenticationState? context;

    protected override async Task OnInitializedAsync()
    {
        context = await AuthenticationStateTask;
    }
}
