<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SSO.Client2WASM</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-auth">
            <AuthorizeView>
                <Authorized>
                    <p>Inloggad som: @context.User.Identity?.Name</p>
                    <button class="nav-link" @onclick="Logout">Logga ut</button>
                </Authorized>
                <NotAuthorized>
                    <p>Inte inloggad.</p>
                    <button class="nav-link" @onclick="Login">Logga in</button>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
    [Inject] SignOutSessionStateManager SignOutManager { get; set; } = default!;

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
    

    private void Login() => Navigation.NavigateTo("authentication/login");
    private async Task Logout()
    {
        await SignOutManager.SetSignOutState();
        Navigation.NavigateTo("authentication/logout");
    }
}

