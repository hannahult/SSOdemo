<div class="sidebar">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SSO.Client2WASM</a>
      <AuthorizeView>
        <Authorized>
                <p class="small mb-2">Logged in as <strong>@context.User.Identity?.Name</strong></p>
           </Authorized>
      </AuthorizeView>

        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>

            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill"></span> Home
            </NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link" href="secure">
                    <span class="bi bi-lock-fill me-1"></span> Secure
                </NavLink>
            </Authorized>
        </AuthorizeView>

    <AuthorizeView>
        <Authorized>
                <button class="btn" @onclick="Logout">
                    Logout
                </button>
        </Authorized>

        <NotAuthorized>
            <button class="btn" @onclick="Login">
                Login
            </button>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
    [Inject] SignOutSessionStateManager SignOutManager { get; set; } = default!;

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
    

    private void Login() => Navigation.NavigateTo("authentication/login");
    private async Task Logout()
    {
        await SignOutManager.SetSignOutState();
        Navigation.NavigateTo("authentication/logout");
    }
}

