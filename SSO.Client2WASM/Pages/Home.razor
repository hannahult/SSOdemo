@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@attribute [AllowAnonymous]

<PageTitle>Home</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <h3>Hello @context.User.Identity?.Name!</h3>
            <p>You are logged in via SSO.</p>
            <button @onclick="Logout">Logga ut</button>
        </Authorized>
        <NotAuthorized>
            <h4>You are not logged in.</h4>
            <a class="btn btn-primary" href="authentication/login">Login</a>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    [Inject] SignOutSessionStateManager SignOutManager { get; set; } = default!;

    private void Login() => Navigation.NavigateTo("authentication/login");
    private async Task Logout()
    {
        await SignOutManager.SetSignOutState();
        Navigation.NavigateTo("authentication/logout");
    }
}