@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Client 2</h1>
    @if (User.Identity.IsAuthenticated)
    {
        <h4>Hello @User.Identity.Name!</h4>
        <p>You are logged in via SSO.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Secure">Show protected information</a>
    }
    else
    {
        <h4>You are not logged in.</h4>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Secure">Login and show protected information</a>
    }
</div>
