@page "/"
@inject NavigationManager Nav

<h3>Välkommen till Client1</h3>

<AuthorizeView>
    <Authorized Context="auth">
        <p>Du är <strong>inloggad</strong> som <strong>@auth.User.Identity.Name</strong></p>

        <p><strong>Dina claims:</strong></p>
        <ul>
            @foreach (var claim in auth.User.Claims)
            {
                <li><code>@claim.Type</code>: @claim.Value</li>
            }
        </ul>

        <button class="btn btn-danger" @onclick="Logout">Logga ut</button>
    </Authorized>

    <NotAuthorized>
        <p>Du är <strong>inte inloggad</strong>.</p>
        <p>Klicka på knappen nedan för att logga in via SSO:</p>
        <button class="btn btn-primary" @onclick="Login">Logga in med SSO</button>



        <a href="https://localhost:7013/connect/authorize?client_id=client1&response_type=code&scope=email%20profile&redirect_uri=https://localhost:7106/signin-oidc">Direkt till IdentityServer</a>

    </NotAuthorized>
</AuthorizeView>

@code {
    void Logout()
    {
        Nav.NavigateTo("authentication/logout", forceLoad: true);
    }

    void Login()
    {
        Nav.NavigateTo("https://localhost:7013/connect/authorize?client_id=client1&response_type=code&scope=email%20profile&redirect_uri=https://localhost:7106/signin-oidc", forceLoad: true);
    }


}
